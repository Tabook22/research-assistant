[Unit]
Description=ResearchGuide AI backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/nasser/apps/reguide/backend
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/home/nasser/apps/reguide/backend/.env
ExecStart=/home/nasser/apps/reguide/backend/.venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8125 --proxy-headers --forwarded-allow-ips 127.0.0.1 --root-path /reguide --workers 1
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
