APP_ENV=development
DEBUG=true
# Disable public signup when accounts are managed by an administrator.
ALLOW_REGISTRATION=true
SECRET_KEY=replace-with-long-random-string
DATABASE_URL=sqlite:///./data/researchguide.db
UPLOAD_DIR=./data/uploads
EXPORT_DIR=./data/exports
MAX_UPLOAD_SIZE_MB=25
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# SpaceXAI / xAI
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
AI_MODEL=grok-4.5
AI_PROVIDER=xai

OPENALEX_MAILTO=you@example.com
CROSSREF_MAILTO=you@example.com
LOG_LEVEL=INFO

# Research desk: optional provider keys (keyword search works without embeddings)
OPENALEX_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=
# Choose an embedding service/model compatible with the embeddings API.
# This sends indexed source passages to the configured embedding provider.
EMBEDDING_MODEL=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
